# Copy this file to backend/.env and adjust as needed.
# Every value below has a working default for local development, so the only
# one you really want to change is SECRET_KEY before putting this on a server.

# --- Core -------------------------------------------------------------------

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-secret-key-change-me

# Never leave this True on a machine reachable from the internet.
DEBUG=True

# Comma separated. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---------------------------------------------------------------

# SQLite needs no setup and is fine for local use. Set this to False and fill in
# the POSTGRES_* values below to use Postgres instead.
USE_SQLITE=True

# POSTGRES_DB=api_sandbox
# POSTGRES_USER=sandbox
# POSTGRES_PASSWORD=sandbox
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- URLs -------------------------------------------------------------------

# Public URL of this backend. Mock endpoint URLs shown in the UI are built from
# it, so it needs to be the address your users actually reach.
SANDBOX_BASE_URL=http://localhost:8000

# Where the frontend runs. Required so the browser is allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Optional ---------------------------------------------------------------

# Google sign-in. Leave both blank to use email and password only, which is the
# usual choice for a local instance. To enable it, create an OAuth client at
# https://console.cloud.google.com/apis/credentials in your own project and put
# the client ID here and in NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Let workspaces bind their own hostnames. Off by default.
# ALLOW_CUSTOM_DOMAINS=False
# CUSTOM_DOMAIN_CNAME_TARGET=

# Rate limits, as DRF throttle rates.
# THROTTLE_ANON=60/min
# THROTTLE_USER=600/min
# THROTTLE_AUTH=20/min

# Caps on what a mock endpoint may do.
# MAX_MOCK_DELAY_MS=5000
# MAX_REQUEST_BODY_BYTES=1048576
